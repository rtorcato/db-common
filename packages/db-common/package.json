{
  "name": "@rtorcato/db-common",
  "version": "1.6.0",
  "homepage": "https://docs.torcato.dev/db-common/",
  "description": "Database-agnostic TypeScript helpers for pagination, query shaping, and result mapping.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rtorcato/db-common.git",
    "directory": "packages/db-common"
  },
  "bugs": {
    "url": "https://github.com/rtorcato/db-common/issues"
  },
  "keywords": [
    "database",
    "pagination",
    "query",
    "typescript",
    "utilities"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "pnpm build",
    "size-limit": "size-limit",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@rtorcato/repo-tooling": "^6.1.0",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.4",
    "size-limit": "^14.2.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "AGENTS.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
