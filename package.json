{
  "name": "db-common-monorepo",
  "private": true,
  "homepage": "https://docs.torcato.dev/db-common/",
  "description": "Database-agnostic TypeScript helpers for pagination, query shaping, and result mapping.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rtorcato/db-common.git"
  },
  "bugs": {
    "url": "https://github.com/rtorcato/db-common/issues"
  },
  "keywords": [
    "database",
    "pagination",
    "query",
    "typescript",
    "utilities"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "pnpm --filter @rtorcato/db-common typecheck",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "pnpm --filter @rtorcato/db-common test",
    "test:watch": "pnpm --filter @rtorcato/db-common test:watch",
    "coverage": "pnpm --filter @rtorcato/db-common coverage",
    "build": "pnpm --filter @rtorcato/db-common build",
    "prepare": "husky",
    "verify": "pnpm check:agents && pnpm typecheck && pnpm check && pnpm test",
    "size-limit": "pnpm --filter @rtorcato/db-common size-limit",
    "sync:agents": "node scripts/sync-agents.mjs",
    "check:agents": "node scripts/sync-agents.mjs --check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rtorcato/repo-tooling": "^6.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --fix --no-errors-on-unmatched"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
